{
  "name": "missa-pagina",
  "version": "1.0.0",
  "private": true,
  "description": "Página pública de MISSA (www.missa-proyectos.com) con formulario de contacto propio",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js --fuente",
    "build": "node scripts/construir.js",
    "mensajes": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/exportar-mensajes.js",
    "probar-correo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/probar-correo.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "javascript-obfuscator": "^4.2.2"
  }
}
