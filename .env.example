# ============================================================
# Configuración del servidor de www.missa-proyectos.com
# Copiar este archivo como ".env" en el servidor y completar.
# El archivo .env NO se sube a git (está en .gitignore).
# ============================================================

# Puerto donde escucha Node (el servidor web / proxy reenvía aquí)
PORT=5002

# Poner 1 si hay un proxy delante (IIS, Nginx, Cloudflare...) para leer la IP real del visitante
TRUST_PROXY=1

# Carpeta de la base de datos (SQLite). Por defecto: ./data
# DATA_DIR=./data

# ---- Envío de correo por Microsoft Graph (Microsoft 365 / Outlook) ----
# Datos de la "Registro de aplicación" en Microsoft Entra ID (ver README-SERVIDOR.md)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Buzón desde el que se envía el aviso y buzón que lo recibe
MAIL_FROM=ventas@missa-ni.com
MAIL_TO=ventas@missa-ni.com

# ---- Envío de cada consulta a NEXO (bandeja «Consultas de la web») ----
# NEXO del mismo servidor y la clave compartida (= WEB_CONSULTAS_CLAVE del conexion.env de NEXO). Vacía: no se envía.
NEXO_URL=http://127.0.0.1:5000
NEXO_CLAVE=
